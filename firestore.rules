rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public read for site content, write allowed for CMS manager
    match /site_content/{document=**} {
      allow read: if true;
      allow write: if true;
    }
    
    // Admin settings and credentials
    match /admin_settings/{document=**} {
      allow read, write: if true;
    }
    
    // Inquiries and consultations submitted by visitors
    match /consultations/{document=**} {
      allow create: if true;
      allow read, write: if true;
    }

    match /messages/{document=**} {
      allow create: if true;
      allow read, write: if true;
    }
  }
}
